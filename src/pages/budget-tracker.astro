---
import ProfileMenu from '../components/ProfileMenu.jsx';
import BudgetTracker from '../components/BudgetTracker.jsx';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content="Club FLE Budget Tracker — AI-powered budgeting with goals, spending insights, habit monitoring, and secure account access." />
	<title>Budget Tracker — Club FLE</title>
</head>
<body>

<div class="grid-bg" aria-hidden="true"></div>
<div class="pg-stars pg-stars-sm" aria-hidden="true"></div>
<div class="pg-stars pg-stars-md" aria-hidden="true"></div>

<nav class="nav">
	<div class="nav-inner">
		<a href="/" class="logo">
			<span class="logo-icon">$</span>
			<span class="logo-word">Club FLE</span>
		</a>
		<div class="nav-links" id="navLinks">
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/#features">Features</a>
			<a href="/budget-tracker" class="active">Budget Tracker</a>
			<a href="/#faq">Contact</a>
			<ProfileMenu client:load />
		</div>
		<button class="burger" id="burger" aria-label="Menu">
			<span></span><span></span><span></span>
		</button>
	</div>
</nav>

<main class="page" id="protectedMain" style="visibility:hidden">
	<div class="container">
		<BudgetTracker client:load />
	</div>
</main>

<footer class="footer">
	<div class="container">
		<p class="footer-copy">&copy; 2026 Financial Literacy Extraordinaire. All rights reserved.</p>
		<div class="footer-links">
			<a href="/">Home</a><span class="footer-dot"></span>
			<a href="/about">About</a><span class="footer-dot"></span>
			<a href="/#features">Features</a><span class="footer-dot"></span>
			<a href="/#faq">Contact</a>
		</div>
		<p class="footer-tagline">Club FLE — Master Your Money. Build Your Future.</p>
	</div>
</footer>

<script type="module">
	import { requireAuth } from '../lib/authGuard';
	requireAuth();
</script>

<script>
	const io = new IntersectionObserver((entries) => {
		entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in-view'); });
	}, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
	document.querySelectorAll('.fade-up').forEach(el => io.observe(el));
	document.getElementById('burger')?.addEventListener('click', () => {
		document.getElementById('navLinks')?.classList.toggle('open');
	});
</script>

</body>
</html>

<style is:global>
:root{
	--bg:#0A0A12;--bg-mid:#0D1B3E;
	--purple:#7B2FF2;--purple-lt:#9B59F0;
	--cyan:#4FD1E8;--gold:#FFD23F;--orange:#FF6B35;
	--green:#4ADE80;--red:#FF5C5C;
	--white:#FFFFFF;--text:#D8D8E8;--gray:#A0A0B8;
	--glass:rgba(255,255,255,.03);
	--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--text);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{text-decoration:none;color:inherit}
.container{max-width:1180px;margin:0 auto;padding:0 24px}

@keyframes twinkle-a{0%{opacity:.3}100%{opacity:.85}}
@keyframes twinkle-b{0%{opacity:.8}100%{opacity:.3}}
@keyframes grid-crawl{0%{background-position:0 0}100%{background-position:60px 60px}}
@keyframes rise{0%{opacity:0;transform:translateY(30px)}100%{opacity:1;transform:translateY(0)}}

.fade-up{opacity:0;transform:translateY(28px);transition:opacity .6s cubic-bezier(.22,1,.36,1) var(--d,.05s),transform .6s cubic-bezier(.22,1,.36,1) var(--d,.05s)}
.fade-up.in-view{opacity:1;transform:translateY(0)}

.grid-bg{position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(123,47,242,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(123,47,242,.03) 1px,transparent 1px);background-size:60px 60px;animation:grid-crawl 22s linear infinite}

.pg-stars{position:fixed;inset:0;pointer-events:none;z-index:0}
.pg-stars-sm{animation:twinkle-a 3s ease-in-out infinite alternate;box-shadow:42px 38px 0 .5px rgba(255,255,255,.6),310px 24px 0 .5px rgba(255,255,255,.5),520px 62px 0 .5px rgba(255,255,255,.7),680px 88px 0 .5px rgba(255,255,255,.5),920px 42px 0 .5px rgba(255,255,255,.55),1180px 55px 0 .5px rgba(255,255,255,.65),85px 620px 0 .5px rgba(255,255,255,.5),375px 750px 0 .5px rgba(255,255,255,.6),620px 865px 0 .5px rgba(255,255,255,.5),880px 940px 0 .5px rgba(255,255,255,.55),130px 155px 0 .5px rgba(255,210,63,.4),820px 1030px 0 .5px rgba(255,210,63,.4)}
.pg-stars-md{animation:twinkle-b 5s ease-in-out infinite alternate;box-shadow:95px 65px 0 .75px rgba(255,255,255,.65),440px 48px 0 .75px rgba(255,255,255,.7),810px 480px 0 .75px rgba(255,255,255,.55),1130px 890px 0 .75px rgba(255,255,255,.6),60px 1265px 0 .75px rgba(255,255,255,.55),380px 250px 0 .75px rgba(255,255,255,.6)}

.nav{position:fixed;top:0;left:0;right:0;z-index:200;background:rgba(10,10,18,.65);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid rgba(123,47,242,.1)}
.nav-inner{max-width:1180px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:72px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.2rem;z-index:201}
.logo-icon{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;background:linear-gradient(135deg,var(--purple),var(--orange));border-radius:11px;font-weight:900;font-size:1.1rem;color:#fff}
.logo-word{color:#fff;letter-spacing:-.3px}
.nav-links{display:flex;align-items:center;gap:28px;font-size:.9rem;font-weight:500}
.nav-links a{color:rgba(255,255,255,.6);transition:color .25s}
.nav-links a:hover,.nav-links a.active{color:#fff}
.burger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px;z-index:201}
.burger span{display:block;width:24px;height:2px;background:#fff;border-radius:2px}

.gl-gold,.gl-cyan,.gl-purple,.gl-orange{-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;font-weight:700}
.gl-gold{background-image:linear-gradient(135deg,#FFD23F,#F5C842);filter:drop-shadow(0 0 10px rgba(255,210,63,.3))}
.gl-cyan{background-image:linear-gradient(135deg,#4FD1E8,#38B5CC);filter:drop-shadow(0 0 10px rgba(79,209,232,.3))}
.gl-purple{background-image:linear-gradient(135deg,#7B2FF2,#9B59F0);filter:drop-shadow(0 0 10px rgba(123,47,242,.3))}
.gl-orange{background-image:linear-gradient(135deg,#FF6B35,#FF8F5E);filter:drop-shadow(0 0 10px rgba(255,107,53,.3))}

.page{position:relative;z-index:1;padding:130px 0 80px}

.page-head{margin-bottom:48px}
.eyebrow{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:3px;color:var(--cyan);margin-bottom:14px}
.page-head h1{font-size:clamp(2rem,4.5vw,3rem);font-weight:900;color:#fff;letter-spacing:-1px;margin-bottom:16px;text-shadow:0 0 50px rgba(123,47,242,.15)}
.page-sub{font-size:1.05rem;color:rgba(255,255,255,.5);max-width:640px;margin-bottom:28px}
.quick-actions{display:flex;gap:12px;flex-wrap:wrap}
.qa-btn{padding:12px 22px;border-radius:12px;font-size:.9rem;font-weight:700;background:var(--glass);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.75);cursor:pointer;transition:transform .3s,box-shadow .3s,border-color .3s}
.qa-btn:hover{transform:translateY(-2px);border-color:rgba(123,47,242,.4);box-shadow:0 0 20px rgba(123,47,242,.15)}
.qa-primary{background:linear-gradient(135deg,var(--purple),var(--orange));color:#fff;border:none;box-shadow:0 0 18px rgba(123,47,242,.3)}
.qa-primary:hover{box-shadow:0 0 30px rgba(123,47,242,.5)}

/* SNAPSHOT */
.snapshot{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:40px}
.snap-card{background:var(--glass);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:22px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);display:flex;flex-direction:column;gap:6px}
.snap-label{font-size:.72rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,.4);font-weight:600}
.snap-value{font-size:1.9rem;font-weight:900}
.snap-note{font-size:.78rem;color:rgba(255,255,255,.4)}
.snap-bar{position:relative;height:8px;border-radius:4px;background:rgba(255,255,255,.06);margin-top:6px;overflow:hidden}
.snap-bar-range{position:absolute;top:0;bottom:0;background:rgba(79,209,232,.18);border-radius:4px}
.snap-bar-actual{position:absolute;top:0;bottom:0;left:0;border-radius:4px;background:linear-gradient(90deg,var(--gold),var(--orange))}
.snap-bar-actual.over{background:linear-gradient(90deg,var(--orange),#FF4444)}
.snap-status{justify-content:center}
.snap-status-text{font-size:.95rem;font-weight:600;color:#fff;line-height:1.5}

/* PANELS */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px}
.panel,.panel-full{background:var(--glass);border:1px solid rgba(255,255,255,.06);border-radius:18px;padding:28px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.panel-full{margin-bottom:24px}
.panel-h{font-size:1.1rem;font-weight:800;color:#fff;margin-bottom:20px;letter-spacing:.3px}

/* AI FEED */
.feed-list{display:flex;flex-direction:column;gap:14px}
.feed-item{padding:14px 16px;border-radius:12px;border-left:3px solid transparent;background:rgba(255,255,255,.02)}
.feed-item p{font-size:.88rem;color:rgba(255,255,255,.6);line-height:1.6}
.feed-cat{display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px}
.accent-purple{border-left-color:var(--purple)}.accent-purple .feed-cat{color:var(--purple-lt)}
.accent-gold{border-left-color:var(--gold)}.accent-gold .feed-cat{color:var(--gold)}
.accent-cyan{border-left-color:var(--cyan)}.accent-cyan .feed-cat{color:var(--cyan)}
.accent-orange{border-left-color:var(--orange)}.accent-orange .feed-cat{color:var(--orange)}

/* ALERTS */
.alert-list{display:flex;flex-direction:column;gap:14px}
.alert-item{padding:14px 16px;border-radius:12px;border-left:3px solid transparent;background:rgba(255,255,255,.02)}
.alert-item p{font-size:.85rem;color:rgba(255,255,255,.55);line-height:1.55}
.alert-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.alert-type{font-size:.78rem;font-weight:700;color:#fff}
.alert-time{font-size:.7rem;color:rgba(255,255,255,.35)}

/* GOALS */
.goal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.goal-card{position:relative;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:24px;border-top:3px solid transparent;transition:transform .3s,box-shadow .3s}
.goal-card:hover{transform:translateY(-4px)}
.goal-card.accent-gold{border-top-color:var(--gold)}
.goal-card.accent-cyan{border-top-color:var(--cyan)}
.goal-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.goal-top h3{font-size:1.05rem;color:#fff;font-weight:800}
.goal-type{font-size:.7rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:1px}
.goal-ring-row{display:flex;align-items:center;gap:18px;margin-bottom:18px}
.goal-ring{position:relative;width:80px;height:80px;flex-shrink:0}
.goal-ring svg{width:100%;height:100%}
.ring-stroke-gold{stroke:url(#none);stroke:var(--gold)}
.ring-stroke-cyan{stroke:var(--cyan)}
.ring-pct{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.9rem;font-weight:800;color:#fff}
.goal-nums{display:flex;flex-direction:column;gap:4px}
.goal-current{font-size:1.3rem;font-weight:800;color:#fff}
.goal-of{font-size:.9rem;color:rgba(255,255,255,.4);font-weight:600}
.goal-due{font-size:.78rem;color:rgba(255,255,255,.4)}
.goal-foot{display:flex;justify-content:space-between;font-size:.8rem;color:rgba(255,255,255,.5);margin-bottom:14px}
.goal-rec{color:var(--gold);font-weight:700}
.goal-status{display:inline-block;padding:5px 14px;border-radius:20px;font-size:.72rem;font-weight:700;text-transform:capitalize}
.status-on-track{background:rgba(74,222,128,.12);color:var(--green)}
.status-needs-attention{background:rgba(255,107,53,.12);color:var(--orange)}

/* WEEKLY SPENDING */
.week-chart{display:flex;flex-direction:column;gap:16px}
.week-row{display:grid;grid-template-columns:110px 1fr 70px;align-items:center;gap:16px}
.week-label{font-size:.82rem;color:rgba(255,255,255,.5);font-weight:600}
.week-bar-track{position:relative;height:10px;border-radius:5px;background:rgba(255,255,255,.05);overflow:hidden}
.week-range{position:absolute;top:0;bottom:0;background:rgba(79,209,232,.15);border-radius:5px}
.week-actual{position:absolute;top:0;bottom:0;left:0;border-radius:5px;background:linear-gradient(90deg,var(--cyan),#38B5CC)}
.week-actual.over{background:linear-gradient(90deg,var(--orange),#FF4444)}
.week-amount{font-size:.85rem;font-weight:700;text-align:right}

/* HABITS */
.habit-list{display:flex;flex-direction:column;gap:14px}
.habit-card{display:flex;align-items:center;gap:16px;padding:16px;border-radius:12px;background:rgba(255,255,255,.02);border-left:3px solid transparent}
.habit-card.accent-orange{border-left-color:var(--orange)}
.habit-card.accent-gold{border-left-color:var(--gold)}
.habit-card.accent-cyan{border-left-color:var(--cyan)}
.habit-icon{font-size:1.5rem}
.habit-info{display:flex;flex-direction:column;flex:1}
.habit-cat{font-size:.9rem;font-weight:700;color:#fff}
.habit-avg{font-size:.78rem;color:rgba(255,255,255,.4)}
.habit-trend{font-size:.78rem;font-weight:600}
.trend-up{color:var(--orange)}
.trend-down{color:var(--green)}
.trend-flat{color:rgba(255,255,255,.4)}

/* INVESTMENTS */
.invest-list{display:flex;flex-direction:column;gap:12px}
.invest-row{display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:16px;padding:14px 16px;border-radius:12px;background:rgba(255,255,255,.02)}
.invest-name{display:flex;flex-direction:column}
.invest-symbol{font-size:.9rem;font-weight:800;color:#fff}
.invest-full{font-size:.72rem;color:rgba(255,255,255,.4)}
.invest-risk{font-size:.7rem;color:rgba(255,255,255,.4);padding:3px 10px;border:1px solid rgba(255,255,255,.1);border-radius:20px}
.invest-value{font-size:.9rem;font-weight:700;color:#fff}
.invest-gain{font-size:.85rem;font-weight:700}
.gain-pos{color:var(--green)}
.gain-neg{color:var(--red)}

/* ACCOUNT ACCESS */
.access-note{font-size:.82rem;color:rgba(255,255,255,.4);margin-bottom:20px;font-style:italic}
.access-list{display:flex;flex-direction:column;gap:12px}
.access-row{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr auto;align-items:center;gap:14px;padding:16px;border-radius:12px;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.05)}
.access-who{display:flex;align-items:center;gap:10px}
.access-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dot-active{background:var(--green);box-shadow:0 0 8px var(--green)}
.dot-inactive{background:rgba(255,255,255,.2)}
.access-name{font-size:.88rem;font-weight:700;color:#fff}
.access-role{font-size:.7rem;color:rgba(255,255,255,.4);padding:2px 8px;border:1px solid rgba(255,255,255,.1);border-radius:10px}
.access-scope,.access-login,.access-expires{font-size:.78rem;color:rgba(255,255,255,.5)}
.access-revoke{padding:8px 16px;border-radius:8px;background:rgba(255,92,92,.1);border:1px solid rgba(255,92,92,.25);color:var(--red);font-size:.78rem;font-weight:700;cursor:pointer;transition:background .3s}
.access-revoke:hover{background:rgba(255,92,92,.2)}

/* FOOTER */
.footer{position:relative;z-index:1;padding:48px 0;background:var(--bg);border-top:1px solid rgba(123,47,242,.08);text-align:center}
.footer-copy{font-size:.85rem;color:rgba(255,255,255,.3);margin-bottom:16px}
.footer-links{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.footer-links a{font-size:.85rem;color:rgba(255,255,255,.4);transition:color .25s}
.footer-links a:hover{color:var(--gold)}
.footer-dot{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.15)}
.footer-tagline{font-size:.75rem;color:rgba(255,255,255,.18);letter-spacing:.5px}

/* RESPONSIVE */
@media(max-width:1024px){
	.snapshot{grid-template-columns:repeat(2,1fr)}
	.goal-grid{grid-template-columns:1fr}
}
@media(max-width:768px){
	.nav-links{position:fixed;inset:0;z-index:200;background:rgba(10,10,18,.97);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);flex-direction:column;justify-content:center;gap:26px;font-size:1.2rem;opacity:0;pointer-events:none;transition:opacity .3s}
	.nav-links.open{opacity:1;pointer-events:auto}
	.burger{display:flex}
	.page{padding:110px 0 60px}
	.snapshot{grid-template-columns:1fr}
	.two-col{grid-template-columns:1fr}
	.week-row{grid-template-columns:80px 1fr 55px;gap:10px}
	.invest-row{grid-template-columns:1fr;gap:8px;text-align:left}
	.access-row{grid-template-columns:1fr;gap:8px}
	.access-revoke{justify-self:start}
}
</style>
